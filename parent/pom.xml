<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <artifactId>rentalert-parent</artifactId>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <artifactId>lombok</artifactId>
                                <groupId>org.projectlombok</groupId>
                            </exclude>
                        </excludes>
                    </configuration>
                    <groupId>org.springframework.boot</groupId>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <artifactId>flatten-maven-plugin</artifactId>
                <configuration>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                    <updatePomFile>true</updatePomFile>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                    </execution>
                    <execution>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                    </execution>
                </executions>
                <groupId>org.codehaus.mojo</groupId>
                <version>${flatten-maven-plugin.version}</version>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <artifactId>lombok</artifactId>
                            <groupId>org.projectlombok</groupId>
                        </path>
                        <path>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <groupId>org.projectlombok</groupId>
                        </path>
                        <path>
                            <artifactId>mapstruct-processor</artifactId>
                            <groupId>org.mapstruct</groupId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <groupId>org.apache.maven.plugins</groupId>
            </plugin>
        </plugins>
    </build>

    <dependencies>

        <dependency>
            <artifactId>lombok</artifactId>
            <groupId>org.projectlombok</groupId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <artifactId>spring-boot-starter-test</artifactId>
            <groupId>org.springframework.boot</groupId>
            <scope>test</scope>
        </dependency>

    </dependencies>
    <dependencyManagement>
        <dependencies>

            <dependency>
                <artifactId>jjwt-api</artifactId>
                <groupId>io.jsonwebtoken</groupId>
                <version>${jwt.version}</version>
            </dependency>

            <dependency>
                <artifactId>jjwt-impl</artifactId>
                <groupId>io.jsonwebtoken</groupId>
                <scope>runtime</scope>
                <version>${jwt.version}</version>
            </dependency>

            <dependency>
                <artifactId>jjwt-jackson</artifactId>
                <groupId>io.jsonwebtoken</groupId>
                <scope>runtime</scope>
                <version>${jwt.version}</version>
            </dependency>

            <dependency>
                <artifactId>common-util</artifactId>
                <groupId>com.rentalert</groupId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <artifactId>redis-util</artifactId>
                <groupId>com.rentalert</groupId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <artifactId>dto</artifactId>
                <groupId>com.rentalert</groupId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <artifactId>internal-integration</artifactId>
                <groupId>com.rentalert</groupId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <artifactId>kafka-util</artifactId>
                <groupId>com.rentalert</groupId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <groupId>org.springdoc</groupId>
                <version>${springdoc.version}</version>
            </dependency>

            <dependency>
                <artifactId>mapstruct</artifactId>
                <groupId>org.mapstruct</groupId>
                <version>${org.mapstruct.version}</version>
            </dependency>

            <dependency>
                <artifactId>mapstruct-processor</artifactId>
                <groupId>org.mapstruct</groupId>
                <version>${org.mapstruct.version}</version>
            </dependency>

            <dependency>
                <artifactId>lombok-mapstruct-binding</artifactId>
                <groupId>org.projectlombok</groupId>
                <version>${lombok-mapstruct-binding.version}</version>
            </dependency>

            <dependency>
                <artifactId>resilience4j-bom</artifactId>
                <groupId>io.github.resilience4j</groupId>
                <scope>import</scope>
                <type>pom</type>
                <version>${resilience4j.version}</version>
            </dependency>

            <dependency>
                <artifactId>resilience4j-spring-boot4</artifactId>
                <groupId>io.github.resilience4j</groupId>
                <version>${resilience4j.version}</version>
            </dependency>

            <dependency>
                <artifactId>spring-cloud-dependencies</artifactId>
                <groupId>org.springframework.cloud</groupId>
                <scope>import</scope>
                <type>pom</type>
                <version>${spring-cloud.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>
    <groupId>com.rentalert</groupId>
    <modelVersion>4.0.0</modelVersion>

    <modules>
        <module>../libs/common-util</module>
        <module>../libs/redis-util</module>
        <module>../libs/dto</module>
        <module>../libs/internal-integration</module>
        <module>../libs/kafka-util</module>
        <module>../services</module>
        <module>../services/config-server</module>
        <module>../services/discovery</module>
        <module>../services/gateway</module>
        <module>../services/identity-ms</module>
        <module>../services/notification-ms</module>
        <module>../services/ops-ms</module>
        <module>../services/listing-ms</module>
        <module>../services/processing-ms</module>
    </modules>

    <packaging>pom</packaging>

    <parent>
        <artifactId>spring-boot-starter-parent</artifactId>
        <groupId>org.springframework.boot</groupId>
        <relativePath/>
        <version>4.1.1</version>
    </parent>

    <properties>
        <flatten-maven-plugin.version>1.8.0</flatten-maven-plugin.version>
        <java.version>21</java.version>
        <jwt.version>0.11.5</jwt.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <org.mapstruct.version>1.6.3</org.mapstruct.version>
        <resilience4j.version>2.4.0</resilience4j.version>
        <revision>0.0.1-SNAPSHOT</revision>
        <spring-cloud.version>2025.1.3</spring-cloud.version>
        <springdoc.version>3.1.1</springdoc.version>
    </properties>

    <version>${revision}</version>

</project>
