<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <artifactId>notification-ms</artifactId>

    <dependencies>

        <dependency>
            <artifactId>spring-boot-starter-mail</artifactId>
            <groupId>org.springframework.boot</groupId>
        </dependency>

        <dependency>
            <artifactId>kafka-util</artifactId>
            <groupId>com.rentalert</groupId>
        </dependency>

        <dependency>
            <artifactId>spring-boot-starter-mail-test</artifactId>
            <groupId>org.springframework.boot</groupId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <artifactId>mapstruct</artifactId>
            <groupId>org.mapstruct</groupId>
        </dependency>

        <dependency>
            <artifactId>telegrambots</artifactId>
            <groupId>org.telegram</groupId>
            <scope>compile</scope>
            <version>${telegrambots.version}</version>
        </dependency>

        <dependency>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
            <groupId>org.springframework.boot</groupId>
        </dependency>

        <dependency>
            <artifactId>spring-boot-http-client</artifactId>
            <groupId>org.springframework.boot</groupId>
        </dependency>

        <dependency>
            <artifactId>spring-boot-starter-websocket</artifactId>
            <groupId>org.springframework.boot</groupId>
        </dependency>

    </dependencies>

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <artifactId>rentalert-service-parent</artifactId>
        <groupId>com.rentalert</groupId>
        <relativePath>../pom.xml</relativePath>
        <version>${revision}</version>
    </parent>

    <properties>
        <telegrambots.version>6.9.7.1</telegrambots.version>
    </properties>

</project>
