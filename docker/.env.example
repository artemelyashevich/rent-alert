# Postgres (docker-compose): суперпользователь и по пользователю на базу каждого сервиса
POSTGRES_USER=rentalert
POSTGRES_PASSWORD=
IDENTITY_DB_USER=identity_ms
IDENTITY_DB_PASSWORD=
NOTIFICATION_DB_USER=notification_ms
NOTIFICATION_DB_PASSWORD=
OPS_DB_USER=ops_ms
OPS_DB_PASSWORD=
LISTING_DB_USER=listing_ms
LISTING_DB_PASSWORD=
PROCESSING_DB_USER=processing_ms
PROCESSING_DB_PASSWORD=

# Инфраструктура
REDIS_HOST=localhost
REDIS_PORT=6400
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Безопасность: одинаковые значения во всех сервисах
APP_AUTH_ACCESS_SECRET=
APP_AUTH_REFRESH_SECRET=
APP_INTERNAL_TOKEN=
APP_CRYPTO_AES_KEY=
APP_CRYPTO_HMAC_KEY=

# Telegram (identity-ms, notification-ms)
TELEGRAM_MAIN_BOT_TOKEN=
TELEGRAM_MAIN_BOT_NAME=
TELEGRAM_BOT_ENABLED=false
FRONT_ADDRESS=
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_BOT_CHAT_ID=
TELEGRAM_URL=https://api.telegram.org/bot%s/sendMessage

# Почта (notification-ms)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Источники объявлений и курсов (processing-ms)
KUFAR_URL=
REALT_URL=
ONLINER_URL=
CURRENCY_FRANKFURTER_URL=https://api.frankfurter.dev

# Необязательные: значения по умолчанию заданы в config-server
# LOG_LEVEL_APP=DEBUG
# PARSER_CITY_REQUEST_DELAY_MS=1000
# PARSER_CITY_REQUEST_JITTER_MS=500
# IP_RATE_LIMIT_ENABLED=true
# IP_RATE_LIMIT_MAX_REQUESTS=60
# IP_RATE_LIMIT_WINDOW_SECONDS=60
# IP_RATE_LIMIT_BLOCK_SECONDS=900
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS_PER_WINDOW=50
# RATE_LIMIT_WINDOW_SECONDS=10
# ACTUATOR_ENDPOINTS=health,info,metrics,prometheus,env
# JACKSON_TIME_ZONE=UTC
